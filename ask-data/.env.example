# =====================================================================
# TEMPLATE: SINGLE GLOBAL CONFIGURATION FOR ALL ask-data SERVICES
# ---------------------------------------------------------------------
# Copy this file to `.env` at the ask-data/ root and fill in real values.
# Do NOT commit the real `.env` file (it contains secrets).
#
# NOTE: On Cloudera AI (CML), you can set these ONCE as Project
# Environment Variables instead — they win over the .env file, so no
# .env is even required in production.
# =====================================================================

# ---------------------------------------------------------------------
# Cloudera Impala Connection Configuration
# ---------------------------------------------------------------------
IMPALA_HOST=your-impala-coordinator.cloudera.site
IMPALA_PORT=443
IMPALA_HTTP_PATH=cliservice
DB_NAME=default
CDP_USER=your_cdp_username
CDP_PASS=your_cdp_password

# ---------------------------------------------------------------------
# Vector Database & Embedding Model Configuration
# ---------------------------------------------------------------------
CHROMA_PERSIST_DIR=/home/cdsw/ask-data/chroma_server/chroma_db
CHROMA_COLLECTION=bank_abc_knowledge
CHROMA_MODEL=all-MiniLM-L6-v2
CHROMA_SERVER_URL=http://localhost:8000
CHROMA_DATA_PATH=/home/cdsw/ask-data/chroma_server/chroma_db

# ---------------------------------------------------------------------
# Backend / RAG Ingest Configuration
# ---------------------------------------------------------------------
# DOCS_DIR is auto-resolved to <ask-data>/data/documents by the backend.
# Only set it here if you need to override the document folder:
# DOCS_DIR=/home/cdsw/ask-data/data/documents

# ---------------------------------------------------------------------
# CML Authentication Token (used by backend to reach chroma_server)
# ---------------------------------------------------------------------
# CML_TOKEN=
# CDSW_API_KEY=

# ---------------------------------------------------------------------
# Frontend Configuration
# ---------------------------------------------------------------------
BACKEND_URL=http://127.0.0.1:8090/ask

# ---------------------------------------------------------------------
# Qwen Inference Configuration
# ---------------------------------------------------------------------
CML_MODEL_NAME=Qwen2.5-3B-Instruct
CML_MODEL_VERSION=1

# ---------------------------------------------------------------------
# LiteLLM Proxy Configuration
# ---------------------------------------------------------------------
# Public/private URL of the Qwen inference app (used by proxy routing).
QWEN_APP_URL=http://127.0.0.1:8001
