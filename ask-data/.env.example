# =====================================================================
# SINGLE GLOBAL CONFIGURATION FOR ALL ask-data SERVICES
# ---------------------------------------------------------------------
# This one .env is shared by: mcp_server, backend, frontend,
# chroma_server, qwen_inference, litellm_proxy.
#
# NOTE: On Cloudera AI (CML), you can set these ONCE as Project
# Environment Variables instead — they win over this file, so no
# .env is even required in production.
# =====================================================================

# ---------------------------------------------------------------------
# Cloudera Impala Connection Configuration
# ---------------------------------------------------------------------
IMPALA_HOST=coordinator-ps-amer-impala-warehouse.dw-ps-amer-sandbox-aws.a465-9q4k.cloudera.site
IMPALA_PORT=443
IMPALA_HTTP_PATH=cliservice
DB_NAME=sb
CDP_USER=
CDP_PASS=

# ---------------------------------------------------------------------
# Vector Database & Embedding Model Configuration
# ---------------------------------------------------------------------
CHROMA_PERSIST_DIR=/home/cdsw/ask-data/chroma_server/chroma_db
CHROMA_COLLECTION=bank_abc_knowledge
CHROMA_MODEL=all-MiniLM-L6-v2
CHROMA_SERVER_URL=https://chroma.ml-95614b64-f85.ps-amer.a465-9q4k.cloudera.site
CHROMA_DATA_PATH=/home/cdsw/ask-data/chroma_server/chroma_db

# ---------------------------------------------------------------------
# Vector Database & Embedding Model Configuration (QDrant)
# ---------------------------------------------------------------------
QDRANT_COLLECTION=bank_abc_knowledge
QDRANT_MODEL=all-MiniLM-L6-v2
QDRANT_SERVER_URL=https://qdrant.ml-95614b64-f85.ps-amer.a465-9q4k.cloudera.site
QDRANT_DATA_PATH="/home/cdsw/ask-data/qdrant_server/qdrant_db"

# ---------------------------------------------------------------------
# Backend / RAG Ingest Configuration
# ---------------------------------------------------------------------
# DOCS_DIR is auto-resolved to <ask-data>/data/documents by the backend.
# Only set it here if you need to override the document folder:
# DOCS_DIR=/home/cdsw/ask-data/data/documents

# ---------------------------------------------------------------------
# CML Authentication Token (used by backend to reach chroma_server)
# ---------------------------------------------------------------------
CML_TOKEN=

# ---------------------------------------------------------------------
# Frontend Configuration
# ---------------------------------------------------------------------
BACKEND_URL=https://backend.ml-95614b64-f85.ps-amer.a465-9q4k.cloudera.site/ask

# ---------------------------------------------------------------------
# Qwen Inference Configuration
# ---------------------------------------------------------------------
CML_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
CML_MODEL_VERSION=1

# ---------------------------------------------------------------------
# LiteLLM Proxy Configuration
# ---------------------------------------------------------------------
# Direct URL of the Qwen inference app (LiteLLM forwards requests here).
QWEN_APP_URL=https://qwen.ml-95614b64-f85.ps-amer.a465-9q4k.cloudera.site/v1

# Public URL of the LiteLLM proxy itself (backend/CrewAI sends LLM
# requests here, and LiteLLM forwards them to QWEN_APP_URL above).
LITELLM_PROXY_URL=https://litellm.ml-95614b64-f85.ps-amer.a465-9q4k.cloudera.site/v1

# ---------------------------------------------------------------------
# MCP Server Configuration
# ---------------------------------------------------------------------
MCP_SERVER_URL=https://mcp.ml-95614b64-f85.ps-amer.a465-9q4k.cloudera.site
